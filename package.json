{
  "name": "@ai-whisperers/base",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "publish-packages": "npm run build && changeset publish",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.0",
    "prettier": "^3.5.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@11.0.0",
  "dependencies": {
    "@ai-whisperers/ui": "^0.4.1",
    "@ai-whisperers/ui-extras": "^0.3.0",
    "@ai-whisperers/seo": "^0.2.1",
    "@ai-whisperers/messaging": "^0.3.0",
    "@ai-whisperers/theme": "^0.3.0",
    "@ai-whisperers/content": "^0.3.0"
  }
}
