# Ai-Whisperers — Environment variables template for Next.js client sites
# Usage: cp .env.example .env.local and fill in values

# ─── Next.js ───────────────────────────────────────────────────────────────
NEXT_TELEMETRY_DISABLED=1

# ─── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Site ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_WHATSAPP=

# ─── Payments: Bancard ────────────────────────────────────────────────────
BANCARD_PUBLIC_KEY=
BANCARD_PRIVATE_KEY=
BANCARD_SANDBOX=true

# ─── Payments: Pagopar ────────────────────────────────────────────────────
PAGOPAR_PUBLIC_KEY=
PAGOPAR_PRIVATE_KEY=

# ─── Evolution API (WhatsApp) ──────────────────────────────────────────────
EVOLUTION_API_URL=http://evolution_api:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

ADMIN_WHATSAPP=
